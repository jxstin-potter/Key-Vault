# Copy to .env and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL. If you use Neon, take the DIRECT connection string, not the
# pooled one (whose hostname ends in -pooler). Prisma's migrate and seed paths
# open multiple sequential connections, and PgBouncer in transaction mode makes
# them hang with no error at all.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/keyvault"

# Token signing key. The server refuses to start in production if this is
# missing or shorter than 32 characters - a weak signing key is a total
# authentication bypass, not a warning.
JWT_SECRET="change-me-to-at-least-32-random-characters"

# CORS origin, and where Stripe returns the customer after payment.
FRONTEND_URL="http://localhost:5173"

PORT=5000
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Payments (optional)
#
# Without these the store still runs: catalogue, accounts, cart and admin all
# work, and only the checkout endpoints return 503. That is deliberate, so
# shipping payment code before the keys are configured cannot take the shop
# down.
#
# Fulfilment happens in the webhook, NOT on the success redirect. Locally that
# means you also need:
#     stripe listen --forward-to localhost:5000/api/webhooks/stripe
# and the whsec_... it prints goes in STRIPE_WEBHOOK_SECRET below. Without it a
# test payment succeeds and no key is ever delivered.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Password for the seeded admin account. Unset in production, seeding generates
# a random one and prints it once to the seed output.
SEED_ADMIN_PASSWORD=""

# trace | debug | info | warn | error | silent
# Defaults to debug locally, info in production, silent under test.
LOG_LEVEL=""

# Point the test suite at a throwaway database. Defaults to
# postgresql://postgres:postgres@127.0.0.1:5432/keyvault_test
TEST_DATABASE_URL=""
