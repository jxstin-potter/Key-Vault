{
  "name": "keyvault-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "build": "echo 'No build step needed for Node.js'",
    "deploy": "node deploy-setup.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node src/seed.js",
    "db:setup": "prisma db push && npm run db:seed",
    "db:reset": "prisma db push --force-reset --accept-data-loss && node src/seed.js"
  },
  "keywords": [
    "ecommerce",
    "api",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "description": "Modern e-commerce backend API",
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^16.10.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.11.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
